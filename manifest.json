{
  "manifest_version": 3,
  "name": "Google Meet - Instant View",
  "version": "1.0",
  "description": "Adds a button to instantly open the Adjust View menu.",
  "icons": {
    "128": "icon.png"
  },
  "action": {
    "default_icon": "icon.png",
    "default_title": "Adjust View"
  },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
