{
  "manifest_version": 2,
  "name": "Google Meet Layout Switcher",
  "version": "1.0.0",
  "description": "Quickly switch between Google Meet layouts (Auto, Tiled, Spotlight, Sidebar) with a single click from the call controls bar.",
  "author": "Gokalp",
  "homepage_url": "https://github.com/gokalp/GoogleMeetChangeLayout",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Google Meet Layout Switcher"
  },
  "permissions": [
    "https://meet.google.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "{e8b3f06d-4a1c-4b9e-9c5f-7d2a8b3e1f09}",
      "strict_min_version": "91.0"
    }
  }
}
